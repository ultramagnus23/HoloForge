# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/
ENV/

# ─── LaTeX build artifacts (paper/) ──────────────────────────────────────────
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.lof
*.lot
# Keep the source .tex; ignore the compiled PDF (regenerate with pdflatex)
part1/paper/*.pdf
part2/paper/*.pdf

# ─── OS / editor cruft ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/

# ─── Result artifacts ────────────────────────────────────────────────────────
# Figures (.png), metric tables (.csv) and notes (.txt) ARE versioned — they
# back the paper. The large intermediate .npy arrays are regenerable by
# run_experiments.py and are not tracked.
part1/code/results/*.npy

# ─── S3 design checkpoints ───────────────────────────────────────────────────
# experiments/run_s3_mismatch.py checkpoints its optimized exposures here so an
# interrupted run resumes without repeating the (expensive) design stage. They
# are regenerable intermediate state, not results -- the 504 evaluation JSONs
# under results/S3/ are what the paper reads -- and no .pt file is tracked
# anywhere else in this repo.
part2/code/results/S3/_designs/
